{$DOMAIN:pdf-actions.13.59.92.146.sslip.io} {
	encode zstd gzip

	request_body {
		max_size {$MAX_UPLOAD_MB:50}MiB
	}

	root * /usr/share/caddy

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:8000
	}

	handle /assets/* {
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
